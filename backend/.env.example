# 大模型配置（兼容 OpenAI 接口，可填 DeepSeek / Qwen / 其他服务）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=90

# 元数据库，默认使用本地 SQLite；也可以改成 MySQL
# METADATA_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/data_agent

# 上传与查询限制
MAX_UPLOAD_MB=20
MAX_RESULT_ROWS=500
QUERY_TIMEOUT=30
MAX_REPAIR=2
